# Scraper Configuration
API_BASE_URL=https://support.optisigns.com/api/v2/help_center/en-us/articles.json
STATE_FILE=scraper_state.json
OUTPUT_DIR=articles
PAGE_SIZE=30

# OpenAI Uploader Configuration
OPENAI_API_KEY=
VECTOR_STORE_ID=
UPLOADER_STATE_FILE=uploader_state.json

# Docker/Cron Configuration
CRON_SCHEDULE=0 2 * * *
TZ=UTC
RUN_ON_STARTUP=true
LOG_FILE=/app/logs/optibot.log